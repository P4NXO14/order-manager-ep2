{
"uid": "order-manager-monitoring",
"title": "Order Manager - Observabilidad",
"description": "Dashboard de monitoreo del microservicio Order Manager",
"tags": ["DevOps", "EP3", "Order Manager"],
"timezone": "browser",
"schemaVersion": 39,
"version": 1,
"refresh": "15s",
"editable": false,
"time": {
    "from": "now-15m",
    "to": "now"
},
"panels": [
    {
    "id": 1,
    "title": "Disponibilidad del microservicio",
    "type": "stat",
    "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
    },
    "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
    },
    "targets": [
        {
        "expr": "up{job=\"order-manager\"}",
        "refId": "A",
        "instant": true
        }
    ],
    "fieldConfig": {
        "defaults": {
        "mappings": [
            {
            "type": "value",
            "options": {
                "0": {
                "text": "DOWN",
                "color": "red"
                },
                "1": {
                "text": "UP",
                "color": "green"
                }
            }
            }
        ],
        "thresholds": {
            "mode": "absolute",
            "steps": [
            {
                "color": "red",
                "value": null
            },
            {
                "color": "green",
                "value": 1
            }
            ]
        }
        }
    },
    "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
        "calcs": ["lastNotNull"]
        }
    }
    },
    {
    "id": 2,
    "title": "Tiempo de actividad",
    "type": "stat",
    "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
    },
    "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
    },
    "targets": [
        {
        "expr": "process_uptime_seconds{job=\"order-manager\"}",
        "refId": "A",
        "instant": true
        }
    ],
    "fieldConfig": {
        "defaults": {
        "unit": "s",
        "decimals": 0,
        "color": {
            "mode": "fixed",
            "fixedColor": "blue"
        }
        }
    },
    "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
        "calcs": ["lastNotNull"]
        }
    }
    },
    {
    "id": 3,
    "title": "Peticiones acumuladas",
    "type": "stat",
    "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
    },
    "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
    },
    "targets": [
        {
        "expr": "sum(http_server_requests_seconds_count{job=\"order-manager\",uri!~\"/actuator.*\"}) or vector(0)",
        "refId": "A",
        "instant": true
        }
    ],
    "fieldConfig": {
        "defaults": {
        "decimals": 0,
        "color": {
            "mode": "fixed",
            "fixedColor": "blue"
        }
        }
    },
    "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
        "calcs": ["lastNotNull"]
        }
    }
    },
    {
    "id": 4,
    "title": "Uso de CPU del proceso",
    "type": "timeseries",
    "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
    },
    "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
    },
    "targets": [
        {
        "expr": "process_cpu_usage{job=\"order-manager\"} * 100",
        "legendFormat": "CPU",
        "refId": "A"
        }
    ],
    "fieldConfig": {
        "defaults": {
        "unit": "percent",
        "min": 0,
        "max": 100,
        "decimals": 2
        }
    }
    },
    {
    "id": 5,
    "title": "Uso de memoria JVM",
    "type": "timeseries",
    "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
    },
    "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
    },
    "targets": [
        {
        "expr": "sum(jvm_memory_used_bytes{job=\"order-manager\"}) by (area)",
        "legendFormat": "{{area}}",
        "refId": "A"
        }
    ],
    "fieldConfig": {
        "defaults": {
        "unit": "bytes",
        "min": 0
        }
    }
    },
    {
    "id": 6,
    "title": "Peticiones HTTP por segundo",
    "type": "timeseries",
    "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
    },
    "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
    },
    "targets": [
        {
        "expr": "sum(rate(http_server_requests_seconds_count{job=\"order-manager\",uri!~\"/actuator.*\"}[1m]))",
        "legendFormat": "Peticiones/s",
        "refId": "A"
        }
    ],
    "fieldConfig": {
        "defaults": {
        "unit": "reqps",
        "min": 0
        }
    }
    },
    {
    "id": 7,
    "title": "Tiempo promedio de respuesta",
    "type": "timeseries",
    "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
    },
    "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
    },
    "targets": [
        {
        "expr": "(sum(rate(http_server_requests_seconds_sum{job=\"order-manager\",uri!~\"/actuator.*\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"order-manager\",uri!~\"/actuator.*\"}[1m]))) * 1000",
        "legendFormat": "Latencia promedio",
        "refId": "A"
        }
    ],
    "fieldConfig": {
        "defaults": {
        "unit": "ms",
        "min": 0,
        "decimals": 2
        }
    }
    },
    {
    "id": 8,
    "title": "Errores HTTP 4xx",
    "type": "stat",
    "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
    },
    "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 20
    },
    "targets": [
        {
        "expr": "sum(http_server_requests_seconds_count{job=\"order-manager\",status=~\"4..\",uri!~\"/actuator.*\"}) or vector(0)",
        "refId": "A",
        "instant": true
        }
    ],
    "fieldConfig": {
        "defaults": {
        "decimals": 0,
        "thresholds": {
            "mode": "absolute",
            "steps": [
            {
                "color": "green",
                "value": null
            },
            {
                "color": "orange",
                "value": 1
            }
            ]
        }
        }
    },
    "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
        "calcs": ["lastNotNull"]
        }
    }
    },
    {
    "id": 9,
    "title": "Errores HTTP 5xx",
    "type": "stat",
    "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
    },
    "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 20
    },
    "targets": [
        {
        "expr": "sum(http_server_requests_seconds_count{job=\"order-manager\",status=~\"5..\",uri!~\"/actuator.*\"}) or vector(0)",
        "refId": "A",
        "instant": true
        }
    ],
    "fieldConfig": {
        "defaults": {
        "decimals": 0,
        "thresholds": {
            "mode": "absolute",
            "steps": [
            {
                "color": "green",
                "value": null
            },
            {
                "color": "red",
                "value": 1
            }
            ]
        }
        }
    },
    "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
        "calcs": ["lastNotNull"]
        }
    }
    }
]
}